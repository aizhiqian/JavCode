# Copy to .env and fill in. Loaded only by process entry points (run.py / CLI / server).

JAVCODE_AI_API_KEY=
JAVCODE_AI_BASE_URL=https://api.x.ai/v1
JAVCODE_AI_MODEL=grok-2-latest
# JAVCODE_AI_ENABLED=1
# JAVCODE_AI_TIMEOUT=60

# Global HTTP proxy for fetch + AI. Empty = direct.
# Web 设置页可覆盖；保存后立即生效。
# JAVCODE_PROXY=http://127.0.0.1:7890

# Optional: bootstrap unique admin on first start (only if not yet configured).
# Prefer the first-run UI setup; these are one-time seeds.
# JAVCODE_ADMIN_USERNAME=admin
# JAVCODE_ADMIN_PASSWORD=

# JAVCODE_DB=data/collection.db
# JAVCODE_HOST=0.0.0.0
# JAVCODE_PORT=8765
